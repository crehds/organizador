.category.show-page
  .page-header
    %div
      %p.page-kicker Categoría
      %h1.page-title= @category.name
    .d-flex.gap-2
      = link_to t("common.back"), categories_path, class: "btn btn-link"
      = link_to t("common.edit"), edit_category_path(@category), class: "btn btn-outline-primary"
  .card
    .card-body
      %dl.facts
        %dt Descripción
        %dd= @category.description.presence || "Sin descripción"
