.categories.index-page
  .page-header
    %div
      %h1.page-title Categorías
      %p.page-lead Agrupan las tareas por tema.
    = link_to new_category_path, class: "btn btn-primary" do
      %i.fa-solid.fa-plus{ "aria-hidden" => "true" }
      = t("categories.new_category")
  - if @categories.empty?
    .card.empty-state
      %p.mb-0 Todavía no hay categorías.
  - else
    .card
      .table-responsive
        %table.table.align-middle.mb-0
          %thead
            %tr
              %th{ scope: "col" } Nombre
              %th{ scope: "col" } Descripción
              %th{ scope: "col" }
                %span.visually-hidden Acciones
          %tbody
            - @categories.each do |category|
              %tr
                %td.fw-semibold= link_to category.name, category
                %td.text-secondary= category.description
                %td
                  .d-flex.justify-content-end.gap-1
                    = link_to t("common.edit"), edit_category_path(category), class: "btn btn-sm btn-outline-primary"
                    = button_to t("common.destroy"), category, method: :delete, class: "btn btn-sm btn-outline-danger", form: { data: { turbo_confirm: t("common.are_you_sure") } }
