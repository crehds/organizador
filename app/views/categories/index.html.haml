.categories.index-page
  .card
    .card-body
      %h1 Lista de Categorías
      %table.table
        %thead
          %tr
            %th Nombre
            %th Descripción
            %th
            %th
            %th
        %tbody
          - @categories.each do |category|
            %tr
              %td= category.name
              %td= category.description
              %td= link_to t("common.show"), category
              %td= link_to t("common.edit"), edit_category_path(category)
              %td= button_to t("common.destroy"), category, method: :delete, class: "btn btn-link p-0", form: { data: { turbo_confirm: t("common.are_you_sure") } }
          %br
          .text-right
            = link_to "Nueva Categoría", new_category_path, class: "btn btn-info"
