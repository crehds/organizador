.tasks.index-page
  .page-header
    %div
      %h1.page-title Tareas
      %p.page-lead Las tareas que creaste y en las que participas. Solo quien crea una tarea puede editarla o eliminarla.
  - if @tasks.empty?
    .card.empty-state
      %p Todavía no hay tareas.
      %div= link_to "Crear la primera tarea", new_task_path, class: "btn btn-primary"
  - else
    %ul.task-list.list-unstyled
      - @tasks.each do |task|
        %li.card.task-card
          .card-body
            .task-card-head
              %h2.task-card-title= link_to task.name, task
              %span.badge.task-category= task.category.name
            - if task.description.present?
              %p.task-card-description= task.description
            %p.task-card-meta
              %span= task.owner.email
              %span= "Creada el #{l task.created_at.to_date, format: :long}"
              %span= "Vence el #{l task.due_date, format: :long}"
            .task-card-foot
              .task-participants
                - task.participating_users.each do |participant|
                  .task-participant{ class: "task-participant--#{participant.role}", title: "#{participant.user.email} · #{t("participant.roles.#{participant.role}")}" }
                    = avatar_for(participant.user, size: 32)
              .dropdown
                %button.btn.btn-sm.btn-light{ type: "button", "data-bs-toggle" => "dropdown", "aria-expanded" => "false", "aria-label" => "Acciones de #{task.name}" }
                  %i.fa-solid.fa-ellipsis-vertical{ "aria-hidden" => "true" }
                .dropdown-menu.dropdown-menu-end
                  = link_to t("common.show"), task, class: "dropdown-item"
                  = link_to t("common.edit"), edit_task_path(task), class: "dropdown-item"
                  = button_to t("common.destroy"), task, method: :delete, class: "dropdown-item text-danger", form: { data: { turbo_confirm: t("common.are_you_sure") } }
