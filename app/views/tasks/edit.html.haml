.tasks.edit-page
  .page-header
    %div
      %p.page-kicker= "Tarea #{@task.code}"
      %h1.page-title Editar tarea
    .d-flex.gap-2
      = link_to t("common.back"), tasks_path, class: "btn btn-link"
      = link_to t("common.show"), @task, class: "btn btn-outline-primary"
  .card
    .card-body
      = render "form"
