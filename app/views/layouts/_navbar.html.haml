    %span.navbar-toggler-icon
  .collapse.navbar-collapse#navbarNavDropdown
    %ul.navbar-nav
      %li.nav-item.active
        %a.nav-link{ href: root_path }
          Inicio
          %span.sr-only (current)
      %li.nav-item
        %a.nav-link{ href: categories_path } Categorías
  = link_to "Crear Tarea", new_task_path, class: "btn btn-light ml-2"
